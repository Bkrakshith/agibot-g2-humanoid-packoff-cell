#usda 1.0
(
    "Generated by assets/cell/build.py - do not edit by hand."
    defaultPrim = "TransferRAT"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "TransferRAT"
{
    def "PhysicsMaterials"
    {
        def Material "Stainless" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:staticFriction = 0.3
        }
    }

    over "Colliders"
    {
        over "Bed" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </TransferRAT/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "Frame" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </TransferRAT/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }
}

