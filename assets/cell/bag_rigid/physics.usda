#usda 1.0
(
    "Generated by assets/cell/build.py - do not edit by hand."
    defaultPrim = "BagRigid"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "BagRigid" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.12

    def "PhysicsMaterials"
    {
        def Material "BagFilm" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    over "Colliders"
    {
        over "Box" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </BagRigid/PhysicsMaterials/BagFilm> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }
    }
}

