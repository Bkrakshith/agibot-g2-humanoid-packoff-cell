#usda 1.0
(
    defaultPrim = "PickTable"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "PickTable"
{
    def Scope "PhysicsMaterials"
    {
        def Material "Stainless" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    over "Top" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
            bindMaterialAs = "weakerThanDescendants"
        )
    }

    over "Lips"
    {
        over "LipPosX" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "LipNegX" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "LipPosY" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }

    over "Frame"
    {
        over "Leg1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "Leg2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "Leg3" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "Leg4" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </PickTable/PhysicsMaterials/Stainless> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }
}

