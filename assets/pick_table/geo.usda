#usda 1.0
(
    defaultPrim = "PickTable"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PickTable"
{
    def Scope "Looks"
    {
        def Material "BrushedStainless"
        {
            token outputs:surface.connect = </PickTable/Looks/BrushedStainless/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.78, 0.77)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "StainlessTube"
        {
            token outputs:surface.connect = </PickTable/Looks/StainlessTube/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.72, 0.72)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "FootPad"
        {
            token outputs:surface.connect = </PickTable/Looks/FootPad/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.15)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Cube "Top" (
        prepend apiSchemas = ["MaterialBindingAPI"]
