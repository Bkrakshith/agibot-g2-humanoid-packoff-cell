over "CaseSealer"
{
    def Scope "PhysicsMaterials"
    {
        def Material "PaintedSteel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1
        }

        def Material "Stainless" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    over "Infeed"
    {
        over "Colliders"
        {
            over "Bed" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </CaseSealer/PhysicsMaterials/Stainless> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.003
                custom float physxCollision:restOffset = 0
            }
        }
    }

