#usda 1.0
(
    "Generated by assets/cartons/build.py - do not edit by hand."
    defaultPrim = "CartonFlatStack"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "CartonFlatStack"
{
    def Scope "PhysicsMaterials"
    {
        def Material "Cardboard" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    over "Colliders"
    {
        over "Box" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </CartonFlatStack/PhysicsMaterials/Cardboard> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }
    }
}

