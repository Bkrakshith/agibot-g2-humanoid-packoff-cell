#usda 1.0
(
    "Generated by assets/floor_bin/build.py - do not edit by hand."
    defaultPrim = "FloorBin"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "FloorBin"
{
    def Scope "PhysicsMaterials"
    {
        def Material "HDPE" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    over "Colliders"
    {
        over "Base" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FloorBin/PhysicsMaterials/HDPE> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }

        over "WallNegX" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FloorBin/PhysicsMaterials/HDPE> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }

        over "WallPosX" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FloorBin/PhysicsMaterials/HDPE> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }

        over "WallNegY" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FloorBin/PhysicsMaterials/HDPE> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }

        over "WallPosY" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FloorBin/PhysicsMaterials/HDPE> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }
    }
}

