#usda 1.0
(
    defaultPrim = "SortRack"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "SortRack"
{
    def Scope "PhysicsMaterials"
    {
        def Material "RollerDeck" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.1
            float physics:restitution = 0
            float physics:staticFriction = 0.1
        }

        def Material "Aluminium" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    over "Shelves"
    {
        over "Level1"
        {
            over "DeckCollider" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </SortRack/PhysicsMaterials/RollerDeck> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }

            over "StopBar" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </SortRack/PhysicsMaterials/Aluminium> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }

        over "Level2"
        {
            over "DeckCollider" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </SortRack/PhysicsMaterials/RollerDeck> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }

            over "StopBar" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </SortRack/PhysicsMaterials/Aluminium> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }
    }

    over "Frame"
    {
        over "UprightFront1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </SortRack/PhysicsMaterials/Aluminium> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "UprightFront2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </SortRack/PhysicsMaterials/Aluminium> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "UprightRear1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </SortRack/PhysicsMaterials/Aluminium> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }

        over "UprightRear2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </SortRack/PhysicsMaterials/Aluminium> (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }
}

