#usda 1.0
(
    "Generated by assets/crates/build.py - do not edit by hand."
    defaultPrim = "CrateStacking224"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "CrateStacking224" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 1.72

    def Scope "PhysicsMaterials"
    {
        def Material "HDPE" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    over "Colliders"
    {
        over "Base" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </CrateStacking224/PhysicsMaterials/HDPE> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.003
            custom float physxCollision:restOffset = 0
        }

