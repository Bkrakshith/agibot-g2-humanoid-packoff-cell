<?xml version="1.0"?>
<package format="3">
  <name>g2cell_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters for the G2 pack-off cell use-case stack (cell.launch.py, teleop_record.launch.py) and the check_stack health script.</description>
  <maintainer email="bangrak2000@gmail.com">Rakshith</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>g2cell_interfaces</exec_depend>
  <exec_depend>g2cell_motion</exec_depend>
  <exec_depend>g2cell_tasks</exec_depend>
  <exec_depend>g2cell_teleop</exec_depend>
  <exec_depend>genie_sim_moveit</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
